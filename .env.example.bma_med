# Canonical env example — sync this file across all three repos
# (bma-med/, bma-health-db/, bma-health/) at the start of every sprint.
# Sprint S1 reference: 2026-05-04
# ───────────────────────────────────────────────────────────────────────

# ── Database (host of the loader process) ──────────────────────────────
# The loader (export.py) and the analytics service connect here.
# Sprint S1 default points at the test DB; flip to bma_health for prod.
DATABASE_URL=postgresql://postgres:bma_health_dev@localhost:5433/bma_med_test?sslmode=disable

# ── Analytics privilege layer (S2-S4 will use this) ────────────────────
# Same DSN by default; in production this should be a SEPARATE role
# (analytics_layer) with row-level read but no write/DDL.
ANALYTICS_DB_URL=postgresql://analytics_layer:CHANGE_ME@localhost:5433/bma_med_test?sslmode=require

# ── Cache (existing bma-health-db dependency) ──────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Admin auth (existing) ──────────────────────────────────────────────
# Replace with a strong random in any non-dev environment.
ADMIN_PASSWORD=admin
API_KEY=dev-api-key
SECRET_KEY=change-me-in-production-use-random-secret

# ── Frontend ───────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Pipeline knobs ─────────────────────────────────────────────────────
# Override where ingest.py reads CSVs from. Default = bma-med/BMI_100/.
# Set by the bma-health-db FastAPI uploader to point at a per-upload tmpdir.
# RAW_ROOT=/tmp/bma-bundle-XXXXXX

# Path to the bma-med pipeline scripts (the FastAPI background-job runner
# subprocesses these). Defaults to /Users/dev/bma-med if unset.
# BMA_MED_HOME=/Users/dev/bma-med

# ── Upload size cap (admin /api/admin/upload-excel) ────────────────────
# Streaming write rejects with HTTP 413 once this many MB is exceeded.
# Default 1024 (1 GB). Increase for very large data dumps; remember to
# bump the pipeline timeouts below at the same time.
BMA_UPLOAD_MAX_MB=1024

# ── Pipeline subprocess timeouts (seconds) ─────────────────────────────
# Sized for ~1 GB / ~10M-row bundles. Scale up if you raise BMA_UPLOAD_MAX_MB.
BMA_TIMEOUT_DEMUX=900       # xlsx → CSV demuxer (only used for .xlsx upload)
BMA_TIMEOUT_INGEST=3600     # bma-med/ingest.py
BMA_TIMEOUT_CLEAN=3600      # bma-med/clean.py
BMA_TIMEOUT_VALIDATE=1800   # bma-med/validate.py
BMA_TIMEOUT_EXPORT=7200     # bma-med/export.py — usually the slowest

# ── Tempfile location (1 GB+ uploads should NOT use tmpfs/RAM) ─────────
# On Linux /tmp is often tmpfs. For 1 GB+ uploads, point this at a disk path:
# TMPDIR=/var/lib/bma-uploads
