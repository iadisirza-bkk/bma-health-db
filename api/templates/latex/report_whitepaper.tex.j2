\section{<< i18n.sec_appendix_formulas >>}

\subsection{<< i18n.chi_square_formula >>}

<< i18n.chi_square_desc >>

\begin{equation}
\chi^2 = \sum_{i=1}^{r}\sum_{j=1}^{c} \frac{(O_{ij} - E_{ij})^2}{E_{ij}}
\end{equation}

<< i18n.chi_square_note >>

\subsection{<< i18n.odds_ratio_formula >>}

<< i18n.odds_ratio_desc >>

\begin{equation}
OR = \frac{a \cdot d}{b \cdot c}
\end{equation}

\begin{equation}
95\%\ CI = \exp\!\left(\ln(OR) \pm 1.96 \sqrt{\frac{1}{a}+\frac{1}{b}+\frac{1}{c}+\frac{1}{d}}\right)
\end{equation}

\subsection{<< i18n.mann_kendall_formula >>}

<< i18n.mann_kendall_desc >>

\begin{equation}
S = \sum_{k=1}^{n-1}\sum_{j=k+1}^{n} \text{sgn}(x_j - x_k)
\end{equation}

\begin{equation}
\tau = \frac{S}{\frac{1}{2}n(n-1)}
\end{equation}

\subsection{<< i18n.sens_slope_formula >>}

<< i18n.sens_slope_desc >>

\begin{equation}
Q_i = \frac{x_j - x_k}{j - k} \quad \text{for all } j > k
\end{equation}

\begin{equation}
\hat{\beta} = \text{median}(Q_i)
\end{equation}

\subsection{<< i18n.logistic_regression_formula >>}

<< i18n.logistic_regression_desc >>

\begin{equation}
\ln\!\left(\frac{p}{1-p}\right) = \beta_0 + \beta_1 x_1 + \beta_2 x_2 + \cdots + \beta_k x_k
\end{equation}

\begin{equation}
OR_j = e^{\beta_j}
\end{equation}

