% ===== Methodology =====
\begin{frame}{หมายเหตุวิธีการ}
  \small
  \begin{itemize}
    \item \textbf{แหล่งข้อมูล:} ตาราง \texttt{raw\_vitalsigns} โครงการตรวจคัดกรองสุขภาพ กทม.
    \item \textbf{นิยาม "ตรวจซ้ำ":} ผู้ป่วยที่มี \texttt{patient\_id} เดียวกันปรากฏในตารางตรวจคัดกรอง
    ตั้งแต่ 2 record ขึ้นไป โดยไม่นับ record ที่ถูกยกเลิก (\texttt{cancel\_status = 1})
    \item \textbf{ช่วงห่างระหว่างครั้ง:} คำนวณจาก \texttt{visit\_date} ของ record ติดกันต่อ patient\_id
    ด้วย SQL window function \texttt{LAG()}
    \item \textbf{k-anonymity:} ข้อมูลสถานพยาบาล/เขตแสดงเฉพาะกลุ่มที่มีผู้ป่วย $\geq 100$ คนต่อสถานที่
  \end{itemize}
\end{frame}

