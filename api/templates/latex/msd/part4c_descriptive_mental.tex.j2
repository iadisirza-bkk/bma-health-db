\centering
\caption{การกระจายระดับความรุนแรงซึมเศร้าตามแบบประเมิน PHQ-9}
\label{tab:phq9}
\begin{tabular}{llr}
\toprule
\textbf{ระดับ (Severity)} & \textbf{คะแนน (Score)} & \textbf{ร้อยละ (\%)} \\
\midrule
น้อยมาก (Minimal) & 0--4 & << data.mental_health.phq9_distribution.minimal >>\% \\
เล็กน้อย (Mild) & 5--9 & << data.mental_health.phq9_distribution.mild >>\% \\
ปานกลาง (Moderate) & 10--14 & << data.mental_health.phq9_distribution.moderate >>\% \\
ค่อนข้างรุนแรง (Moderately Severe) & 15--19 & << data.mental_health.phq9_distribution.moderately_severe >>\% \\
รุนแรง (Severe) & 20--27 & \riskcell{<< data.mental_health.phq9_distribution.severe >>} \\
\bottomrule
\end{tabular}
\end{table}

