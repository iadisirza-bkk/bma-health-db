\subsection{การวิเคราะห์ Post-hoc (Pairwise Zone Comparison)}
\label{sec:zone_posthoc}

สำหรับโรคที่ ANOVA พบความแตกต่างอย่างมีนัยสำคัญ ($p < 0.05$)
ใช้ Tukey HSD (Honestly Significant Difference) ระบุคู่โซนที่แตกต่างกัน

<% for d in data.zone_comparison.posthoc_results %>
<% if d.significant_pairs|length > 0 %>
\subsubsection{Post-hoc: << d.name_th >> (<< d.name_en >>)}

\begin{table}[H]
\centering
\caption{คู่โซนที่มีความแตกต่างอย่างมีนัยสำคัญ --- << d.name_th >> (Tukey HSD, $p < 0.05$)}
\label{tab:posthoc_<< d.disease >>}
\begin{tabular}{llrrl}
\toprule
\textbf{โซน A} & \textbf{โซน B} & \textbf{ผลต่างเฉลี่ย (pp)} & \textbf{p-value (adj.)} & \textbf{ทิศทาง} \\
\midrule
<% for pair in d.significant_pairs %>
โซน << pair.zone_a >> & โซน << pair.zone_b >> & << pair.mean_diff >> & << pair.p_adj >> \sigmark{<< pair.p_adj >>} &
<% if pair.mean_diff > 0 %>A $>$ B<% else %>B $>$ A<% endif %> \\
<% endfor %>
\bottomrule
\end{tabular}
\end{table}
<% endif %>
<% endfor %>

