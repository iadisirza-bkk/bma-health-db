\subsection{ผล ANOVA เปรียบเทียบข้ามโซน (ANOVA Results)}
\label{sec:zone_anova}

ผลการวิเคราะห์ความแปรปรวนทางเดียว (One-Way ANOVA)
เปรียบเทียบค่าเฉลี่ยร้อยละความเสี่ยงระหว่าง 8 โซน

\begin{table}[H]
\centering
\caption{ผล One-Way ANOVA เปรียบเทียบร้อยละความเสี่ยง NCD ระหว่าง 8 โซน}
\label{tab:zone_anova}
\begin{tabular}{lrrrrrl}
\toprule
\textbf{โรค (Disease)} & \textbf{F} & \textbf{df$_1$} & \textbf{df$_2$} & \textbf{p-value} & \textbf{$\eta^2$} & \textbf{สรุป} \\
\midrule
<% for d in data.zone_comparison.anova_results %>
<< d.name_th >> (<< d.name_en >>) & << d.f_stat >> & 7 & << d.df2 >> & << d.p_value >> \sigmark{<< d.p_value >>} & << d.eta_sq >> &
<% if d.significant %>แตกต่าง<% else %>ไม่แตกต่าง<% endif %> \\
<% endfor %>
\bottomrule
\end{tabular}
\end{table}

