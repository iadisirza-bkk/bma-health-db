% ===== Frame 2: Overview =====
\begin{frame}{{\bmafont ภาพรวม — << disease_name_th >>}}
  \begin{columns}[T]
    \begin{column}{0.45\textwidth}
      \metricbox{จำนวนผู้คัดกรองทั้งหมด}{<< total_screened >>}
      \vspace{8pt}
      \metricbox{สัดส่วนกลุ่มเสี่ยง}{\risklabel{<< avg_pct >>}}
    \end{column}
    \begin{column}{0.45\textwidth}
      \metricbox{จำนวนกลุ่มเสี่ยง}{<< total_at_risk >>}
      \vspace{8pt}
      \metricbox{จำนวนเขต}{50 เขต}
    \end{column}
  \end{columns}
  \vspace{10pt}
  \begin{block}{สถิติเชิงพรรณนา}
    \small
    ค่าเฉลี่ย \textbf{<< avg_pct >>\%} ~~~
    SD \textbf{<< std_pct >>\%} ~~~
    ต่ำสุด \textbf{<< min_pct >>\%} ~~~
    สูงสุด \textbf{<< max_pct >>\%}
  \end{block}
\end{frame}

% ===== Frame 3: Top 10 Districts =====
\begin{frame}{{\bmafont เขตที่มีความเสี่ยงสูงสุด 10 อันดับ}}
  <% if chart_path %>
  \begin{center}
    \includegraphics[width=0.85\textwidth]{<< chart_path >>}
  \end{center}
  <% else %>
  \begin{table}
    \centering\small
    \begin{tabular}{clc}
      \toprule
      \textbf{อันดับ} & \textbf{เขต} & \textbf{สัดส่วนเสี่ยง} \\
      \midrule
      <% for d in top_districts[:10] %>
      << loop.index >> & << d.name >> & \risklabel{<< d.pct >>} \\
      <% endfor %>
      \bottomrule
    \end{tabular}
  \end{table}
  <% endif %>
\end{frame}

% ===== Frame 4: Bottom 10 Districts =====
\begin{frame}{{\bmafont เขตที่มีความเสี่ยงต่ำสุด 10 อันดับ}}
  \begin{table}
    \centering\small
    \begin{tabular}{clc}
      \toprule
      \textbf{อันดับ} & \textbf{เขต} & \textbf{สัดส่วนเสี่ยง} \\
      \midrule
      <% for d in bottom_districts[:10] %>
      << loop.index >> & << d.name >> & \risklabel{<< d.pct >>} \\
      <% endfor %>
      \bottomrule
    \end{tabular}
  \end{table}
\end{frame}

