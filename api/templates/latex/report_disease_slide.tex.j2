  Path=assets/,
  BoldFont=GoogleSans-Bold.ttf,
]
\setdefaultlanguage{english}

\begin{document}

% ===== Frame 1: Custom Title =====
{
\setbeamercolor{background canvas}{bg=bmagreen}
\begin{frame}[plain]
  \centering
