  % Logos on top
  \includegraphics[height=2cm]{assets/bma_logo.png}\hspace{1.5cm}%
  \includegraphics[height=2cm]{assets/msd_logo.png}\\[16pt]
  % Title
  {\Huge\bfseries\color{white}\bmafont << disease_name_th >>}\\[8pt]
