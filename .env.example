# Database
DB_PASSWORD=bma_health_dev
DATABASE_URL=postgresql://postgres:bma_health_dev@localhost:5432/bma_health

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_KEY=dev-api-key
CORS_ORIGINS=http://localhost:3000

# MCP Server
MCP_AUDIT_LOG_PATH=/var/log/bma-health/mcp-audit.jsonl
K_ANONYMITY_THRESHOLD=5

# Admin Panel
ADMIN_PASSWORD=admin
SECRET_KEY=change-me-in-production-use-random-secret

# IDCARD Hashing (HMAC secret — store separately from database)
IDCARD_HASH_SECRET=dev-hash-secret-change-in-production

# ETL
DATA_DIR=./minimal_data/portal_top

# --- LLM / AI Chat ---
LMSTUDIO_URL=http://localhost:5555
LLM_MODEL=google/gemma-4-26b-a4b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=120
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY=60

# --- JWT Auth ---
JWT_SECRET=change-me-in-production-use-random-secret
JWT_EXPIRATION=3600

# --- Report Generation ---
TECTONIC_PATH=/opt/homebrew/bin/tectonic
TECTONIC_TIMEOUT=120
REPORTS_DIR=./data/reports
