# Database
DB_PASSWORD=bma_health_dev
DATABASE_URL=postgresql://postgres:bma_health_dev@localhost:5432/bma_health

# Redis
REDIS_URL=redis://localhost:6379/0

# Deployment environment — MUST be one of: development, test, production
# Production refuses to start with insecure default secrets.
# An unset/empty value is also treated as production for safety.
ENVIRONMENT=development

# API
# REQUIRED. App refuses to start in production with this default value.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEY=dev-api-key
CORS_ORIGINS=http://localhost:3000

# MCP Server
MCP_AUDIT_LOG_PATH=/var/log/bma-health/mcp-audit.jsonl
K_ANONYMITY_THRESHOLD=5

# Admin Panel
# REQUIRED. App refuses to start in production with these default values.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_PASSWORD=
SECRET_KEY=

# IDCARD Hashing — HMAC secret. REQUIRED. ETL will refuse to start without it.
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Store separately from database (env var or KMS). Min 16 chars, recommend 32+.
# WARNING: changing this invalidates all existing hashes — re-run ETL to re-hash.
IDCARD_HASH_SECRET=

# ETL
DATA_DIR=./minimal_data/portal_top

# --- LLM / AI Chat ---
LMSTUDIO_URL=http://localhost:5555
LLM_MODEL=google/gemma-4-26b-a4b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=120
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY=60

# --- JWT Auth ---
# REQUIRED. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRATION=3600

# --- Report Generation ---
TECTONIC_PATH=/opt/homebrew/bin/tectonic
TECTONIC_TIMEOUT=120
REPORTS_DIR=./data/reports
